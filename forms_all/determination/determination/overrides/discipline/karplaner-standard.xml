<viewset name="Karplaner - standard" source="db" level="Discipline">
  <views>
    <view name="Determination" class="edu.ku.brc.specify.datamodel.Determination" busrules="edu.ku.brc.specify.datamodel.busrules.DeterminationBusRules" isexternal="true">
      <desc>Subform within the Collection Object form.</desc>
      <altviews>
        <altview name="Determination View" viewdef="Determination" mode="view" />
        <altview name="Determination Edit" viewdef="Determination" mode="edit" default="true" />
        <altview name="Determination Table View" viewdef="Determination Table" mode="view" />
        <altview name="Determination Table Edit" viewdef="Determination Table" mode="edit" />
      </altviews>
    </view>
  </views>
  <viewdefs>
    <viewdef name="Determination" class="edu.ku.brc.specify.datamodel.Determination" type="form" gettable="edu.ku.brc.af.ui.forms.DataGetterForObj" settable="edu.ku.brc.af.ui.forms.DataSetterForObj">
      <desc>Determination subform for Collection Object form.</desc>
      <enableRules />
      <!-- Match Collection Object 6-content-column grid (colspan sum ≤ 12). -->
      <columnDef>120px,2px,200px,5px,120px,2px,200px,5px,120px,2px,200px,p:g</columnDef>
      <columnDef os="lnx">120px,2px,200px,5px,120px,2px,200px,5px,120px,2px,200px,p:g</columnDef>
      <columnDef os="mac">130px,2px,220px,5px,130px,2px,220px,5px,130px,2px,220px,p:g</columnDef>
      <columnDef os="exp">p,2px,p:g,5px:g,p,2px,p:g,5px:g,p,2px,p:g,p:g</columnDef>
      <rowDef auto="true" cell="p" sep="2px" />
      <rows>
        <!-- Working identification: taxon tree link is the source of truth. -->
        <row>
          <cell type="label" label="Taxon" labelfor="1" />
          <cell type="field" id="1" name="taxon" uitype="querycbx" initialize="name=Taxon" colspan="7" />
          <cell type="field" id="3" name="isCurrent" uitype="checkbox" />
        </row>
        <row>
          <cell type="label" label="Entered taxon name" labelfor="dt1" />
          <cell type="field" id="dt1" name="text1" uitype="text" colspan="9" />
        </row>
        <row>
          <cell type="label" label="Valid taxon name" labelfor="dt2" />
          <cell type="field" id="dt2" name="text2" uitype="text" readonly="true" colspan="9" />
        </row>
        <row>
          <cell type="label" label="Accepted taxon name" labelfor="13" />
          <cell type="field" id="13" name="preferredTaxon" uitype="text" readonly="true" colspan="9" />
        </row>
        <row>
          <cell type="label" label="Infraspecific rank" labelfor="dt4" />
          <cell type="field" id="dt4" name="text4" uitype="combobox" picklist="InfraspecificRank" />
          <cell type="label" label="Infraspecific name" labelfor="dt3" />
          <cell type="field" id="dt3" name="text3" uitype="text" />
          <cell type="label" label="Sensu" labelfor="dt_add" />
          <cell type="field" id="dt_add" name="addendum" uitype="combobox" picklist="DeterminationAddendum" />
        </row>
        <row>
          <cell type="label" labelfor="7" />
          <cell type="field" id="7" uitype="plugin" name="this" initialize="name=PartialDateUI;df=determinedDate;tp=determinedDatePrecision" uifieldformatter="Date" colspan="4" />
          <cell type="label" labelfor="6" />
          <cell type="field" id="6" name="typeStatusName" uitype="combobox" colspan="4" />
        </row>
        <row>
          <cell type="subview" id="citations" name="determinationCitations" viewname="DeterminationCitation" colspan="12" />
        </row>
        <row>
          <cell type="subview" id="determiners" name="determiners" viewname="Determiners" colspan="12" />
        </row>
        <row>
          <cell type="label" label="Note" labelfor="drm" />
          <cell type="field" id="drm" name="remarks" uitype="textareabrief" rows="2" colspan="9" />
        </row>
      </rows>
    </viewdef>
    <viewdef type="formtable" name="Determination Table" class="edu.ku.brc.specify.datamodel.Determination" gettable="edu.ku.brc.af.ui.forms.DataGetterForObj" settable="edu.ku.brc.af.ui.forms.DataSetterForObj">
      <desc>Determination subform table for Collection Object form.</desc>
      <definition>Determination</definition>
    </viewdef>
  </viewdefs>
</viewset>
